{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": true,
      "customDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "slug": "primary",
          "name": "Primary",
          "color": "#358c9d"
        },
        {
          "slug": "primary-dark",
          "name": "Primary Dark",
          "color": "#256d7a"
        },
        {
          "slug": "primary-light",
          "name": "Primary Light",
          "color": "#5ab3c4"
        },
        {
          "slug": "ink",
          "name": "Ink",
          "color": "#111827"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#5b6472"
        },
        {
          "slug": "line",
          "name": "Line",
          "color": "#e8edf2"
        },
        {
          "slug": "background",
          "name": "Background",
          "color": "#f7fafc"
        },
        {
          "slug": "card",
          "name": "Card",
          "color": "#ffffff"
        },
        {
          "slug": "soft",
          "name": "Soft",
          "color": "#eef7f8"
        }
      ]
    },
    "layout": {
      "contentSize": "860px",
      "wideSize": "1280px"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vw",
        "vh"
      ]
    },
    "typography": {
      "customFontSize": true,
      "fluid": true,
      "lineHeight": true,
      "fontFamilies": [
        {
          "slug": "inter",
          "name": "Inter",
          "fontFamily": "Inter, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "size": "0.875rem",
          "name": "Small"
        },
        {
          "slug": "medium",
          "size": "1rem",
          "name": "Medium"
        },
        {
          "slug": "large",
          "size": "1.25rem",
          "name": "Large"
        },
        {
          "slug": "x-large",
          "size": "2rem",
          "name": "Extra Large"
        },
        {
          "slug": "xx-large",
          "size": "3rem",
          "name": "Display"
        }
      ]
    }
  },
  "styles": {
    "css": ":root { --primary: #358c9d; --primary-dark: #256d7a; --primary-light: #5ab3c4; --ink: #111827; --muted: #5b6472; --line: #e8edf2; --bg: #f7fafc; --card: #ffffff; --soft: #eef7f8; --shadow: 0 10px 30px rgba(10, 23, 38, 0.08); --shadow-hover: 0 20px 40px rgba(10, 23, 38, 0.15); --radius: 24px; --max: 1200px; --transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1); --transition-bounce: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1); }",
    "color": {
      "background": "#ffffff",
      "text": "#111827"
    },
    "spacing": {
      "blockGap": "1.5rem"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|inter",
      "lineHeight": "1.5"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontWeight": "700",
          "lineHeight": "1.1",
          "letterSpacing": "-0.05em"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|primary-dark"
        },
        "typography": {
          "textDecoration": "none"
        }
      },
      "button": {
        "border": {
          "radius": "999px"
        },
        "color": {
          "background": "var:preset|color|primary",
          "text": "var:preset|color|card"
        },
        "spacing": {
          "padding": {
            "top": "0.9rem",
            "right": "1.5rem",
            "bottom": "0.9rem",
            "left": "1.5rem"
          }
        },
        "typography": {
          "fontWeight": "700"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-builder",
      "title": "Full Builder Page",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-blog",
      "title": "Blog Landing",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-contact",
      "title": "Contact Page",
      "postTypes": [
        "page"
      ]
    }
  ]
}
